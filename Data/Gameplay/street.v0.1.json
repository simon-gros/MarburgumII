{
  "format": "marburgumii.street",
  "version": "0.1.0",
  "status": "stage1_lent_street_people",
  "description": "Street people carried forward from the original Marburgum's ambient population: who walks Lent, how far off they appear and go, and what each personality does about a fight, a run-over, someone on the ground, being hit or being walked into. Mirrors MarburgumIIShared/Public/MarburgumStreetContract.h; `mb2 validate street` keeps them in step. Distances in metres, speeds in metres per second, times in seconds. Decision weights are relative, per column [stranger, player].",
  "provenance": {
    "source": "magna-raedarum-marburgum: UnrealMarburgum/Source/MarburgumServer/Private/MarburgumAmbientPopulation.cpp and MarburgumRunOver, docs/AMBIENT_STREETS.md, project/data/population_groups.json, project/data/npc_visual_profiles.json (branches main, feat/ambient-react-to-bodies, feat/ambient-panic-spread)",
    "copied_unchanged": [
      "groups (archetypes, walk speeds, personality mixes)",
      "looks (profile colours and scale)",
      "old_town day mix",
      "decisions: body, attacked, bumped",
      "fight clearance, watch standoff, crowd spread, body notice and stand-by distances",
      "run-over strike speed, margin, damage per m/s and down time"
    ],
    "marburgum_ii_own": [
      "decisions: fight (the original's row was San Andreas' shipped R_Norm/R_Tough/R_Weak values) and run_over (none in the original)",
      "people per player, spawn and cull distances (the original's were San Andreas' view bands)",
      "graph walking: continuous heading with weighted branches (the original used GTA III's 45-degree headings)",
      "fight notice radius 30 m (the original's 40 m was San Andreas')",
      "flee, watch and dodge timings",
      "colour and size variation within a look"
    ],
    "excluded": [
      "San Andreas decision weights",
      "San Andreas spawn/cull bands",
      "GTA III wander, signal clock and car following",
      "crime points, pursuit, officers",
      "ambient traffic and carjacking (Marburgum II has no traffic yet)",
      "attractors, time of day and weekend tables (no world clock yet)",
      "placeholder San Andreas / GTA III bodies"
    ]
  },
