#: Source/MarburgumIIClient/Private/UI/MarburgumSettingsPanel.cpp(122)
msgctxt "MarburgumSettingsPanel,ScaleFixed"
msgid "The size of every panel and text on top of the display's own scaling. Fixed for this run by -MB2UIScale."
msgstr "Velikost vseh plošč in besedila poleg povečave, ki jo uporablja zaslon. Za ta zagon je določena s parametrom -MB2UIScale."

#. Key:	ScaleDesc
#. SourceLocation:	Source/MarburgumIIClient/Private/UI/MarburgumSettingsPanel.cpp(123)
#: Source/MarburgumIIClient/Private/UI/MarburgumSettingsPanel.cpp(123)
msgctxt "MarburgumSettingsPanel,ScaleDesc"
msgid "The size of every panel and text on top of the display's own scaling. 100 % suits most screens; raise it on a large television or a high-density laptop."
msgstr "Velikost vseh plošč in besedila poleg povečave, ki jo uporablja zaslon. 100 % ustreza večini zaslonov; povečaj jo na velikem televizorju ali prenosniku z visoko gostoto slikovnih pik."

#. Key:	TextLabel
#. SourceLocation:	Source/MarburgumIIClient/Private/UI/MarburgumSettingsPanel.cpp(125)
#: Source/MarburgumIIClient/Private/UI/MarburgumSettingsPanel.cpp(125)
msgctxt "MarburgumSettingsPanel,TextLabel"
msgid "Text size"
msgstr "Velikost besedila"

#. Key:	TextDesc
#. SourceLocation:	Source/MarburgumIIClient/Private/UI/MarburgumSettingsPanel.cpp(126)
#: Source/MarburgumIIClient/Private/UI/MarburgumSettingsPanel.cpp(126)
msgctxt "MarburgumSettingsPanel,TextDesc"
msgid "Larger reading text in panels, the journal, chat and subtitles, without enlarging the frames."
msgstr "Večje besedilo na ploščah, v dnevniku, klepetu in podnapisih, brez povečanja okvirjev."

#. Key:	ContrastLabel
#. SourceLocation:	Source/MarburgumIIClient/Private/UI/MarburgumSettingsPanel.cpp(127)
#: Source/MarburgumIIClient/Private/UI/MarburgumSettingsPanel.cpp(127)
msgctxt "MarburgumSettingsPanel,ContrastLabel"
msgid "High contrast"
msgstr "Visok kontrast"

#. Key:	ContrastDesc
