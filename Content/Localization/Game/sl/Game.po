#: Source/MarburgumIIClient/Private/UI/MarburgumSettingsPanel.cpp(128)
msgctxt "MarburgumSettingsPanel,ContrastDesc"
msgid "Opaque panels, brighter secondary text and stronger outlines that read over any street."
msgstr "Neprosojne plošče, svetlejše pomožno besedilo in izrazitejši obrisi, ki so dobro vidni na ozadju katere koli ulice."

#. Key:	MotionLabel
#. SourceLocation:	Source/MarburgumIIClient/Private/UI/MarburgumSettingsPanel.cpp(129)
#: Source/MarburgumIIClient/Private/UI/MarburgumSettingsPanel.cpp(129)
msgctxt "MarburgumSettingsPanel,MotionLabel"
msgid "Reduce motion"
msgstr "Zmanjšaj gibanje"

