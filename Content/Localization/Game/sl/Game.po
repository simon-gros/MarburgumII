#: Source/MarburgumIIClient/Private/UI/MarburgumEvidenceText.cpp(20)
msgctxt "MarburgumEvidence,Inference"
msgid "Inference"
msgstr "Sklep"

#. Key:	OriginalMeaning
#. SourceLocation:	Source/MarburgumIIClient/Private/UI/MarburgumEvidenceText.cpp(31)
#: Source/MarburgumIIClient/Private/UI/MarburgumEvidenceText.cpp(31)
msgctxt "MarburgumEvidence,OriginalMeaning"
msgid "The thing itself. What it proves depends on where it has been: keep its custody unbroken."
msgstr "Stvar sama. Kaj dokazuje, je odvisno od tega, kje je bila: skrbi, da hramba ostane nepretrgana."

#. Key:	PrintMeaning
#. SourceLocation:	Source/MarburgumIIClient/Private/UI/MarburgumEvidenceText.cpp(33)
#: Source/MarburgumIIClient/Private/UI/MarburgumEvidenceText.cpp(33)
msgctxt "MarburgumEvidence,PrintMeaning"
msgid "A photographic print. It shows what was in front of the lens; when and where still has to be established."
msgstr "Fotografski odtis. Kaže, kar je bilo pred objektivom; kdaj in kje, je treba še ugotoviti."

#. Key:	CopyMeaning
#. SourceLocation:	Source/MarburgumIIClient/Private/UI/MarburgumEvidenceText.cpp(35)
#: Source/MarburgumIIClient/Private/UI/MarburgumEvidenceText.cpp(35)
msgctxt "MarburgumEvidence,CopyMeaning"
msgid "A copy. It records what the original says; the original, kept elsewhere, is what can be authenticated."
msgstr "Kopija. Beleži, kar piše v izvirniku; overiti je mogoče le izvirnik, ki ga hranijo drugje."

#. Key:	TestimonyMeaning
#. SourceLocation:	Source/MarburgumIIClient/Private/UI/MarburgumEvidenceText.cpp(37)
#: Source/MarburgumIIClient/Private/UI/MarburgumEvidenceText.cpp(37)
msgctxt "MarburgumEvidence,TestimonyMeaning"
msgid "What a person said. It can be true and still needs paper or a place to stand on."
msgstr "Kar je nekdo povedal. Lahko drži, pa vseeno potrebuje papir ali kraj, na katerega se opre."

#. Key:	NoteMeaning
#. SourceLocation:	Source/MarburgumIIClient/Private/UI/MarburgumEvidenceText.cpp(39)
#: Source/MarburgumIIClient/Private/UI/MarburgumEvidenceText.cpp(39)
msgctxt "MarburgumEvidence,NoteMeaning"
msgid "Information. Useful for finding things; it proves nothing by itself."
msgstr "Informacija. Koristna pri iskanju; sama po sebi ne dokazuje ničesar."

#. Key:	InferenceMeaning
#. SourceLocation:	Source/MarburgumIIClient/Private/UI/MarburgumEvidenceText.cpp(41)
#: Source/MarburgumIIClient/Private/UI/MarburgumEvidenceText.cpp(41)
msgctxt "MarburgumEvidence,InferenceMeaning"
msgid "A conclusion drawn from other evidence. It is only as strong as what it rests on."
msgstr "Sklep iz drugih dokazov. Močan je le toliko, kolikor je močno tisto, na čemer temelji."

