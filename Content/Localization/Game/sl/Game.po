#: Source/MarburgumIIClient/Private/UI/MarburgumSettingsPanel.cpp(130)
msgctxt "MarburgumSettingsPanel,MotionDesc"
msgid "No slides, pulses or long fades: titles and notifications appear and leave at once."
msgstr "Brez drsenja, utripanja ali dolgega bledenja: naslovi in obvestila se pojavijo in izginejo takoj."

#. Key:	HudLabel
#. SourceLocation:	Source/MarburgumIIClient/Private/UI/MarburgumSettingsPanel.cpp(131)
#: Source/MarburgumIIClient/Private/UI/MarburgumSettingsPanel.cpp(131)
msgctxt "MarburgumSettingsPanel,HudLabel"
msgid "HUD opacity"
msgstr "Neprosojnost prikaza HUD"

