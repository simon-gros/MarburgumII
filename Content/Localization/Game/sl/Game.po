#. Key:	MethodNotAllowed
#. SourceLocation:	Source/MarburgumIIClient/Private/Session/MarburgumAccountSubsystem.cpp(100)
#: Source/MarburgumIIClient/Private/Session/MarburgumAccountSubsystem.cpp(100)
msgctxt "MarburgumAccount,MethodNotAllowed"
msgid "The account service did not understand the request. Update the game and try again."
msgstr "Storitev za račune ni razumela zahteve. Posodobi igro in poskusi znova."

#. Key:	ServerTrouble
#. SourceLocation:	Source/MarburgumIIClient/Private/Session/MarburgumAccountSubsystem.cpp(108)
#: Source/MarburgumIIClient/Private/Session/MarburgumAccountSubsystem.cpp(108)
msgctxt "MarburgumAccount,ServerTrouble"
msgid "The account service is having trouble. Try again in a minute."
msgstr "Storitev za račune ima težave. Poskusi znova čez minuto."

#. Key:	Unknown
#. SourceLocation:	Source/MarburgumIIClient/Private/Session/MarburgumAccountSubsystem.cpp(109)
#: Source/MarburgumIIClient/Private/Session/MarburgumAccountSubsystem.cpp(109)
msgctxt "MarburgumAccount,Unknown"
msgid "The account service could not do that. Try again in a minute."
msgstr "Storitev za račune tega ni mogla izvesti. Poskusi znova čez minuto."

#. Key:	CodeSent
#. SourceLocation:	Source/MarburgumIIClient/Private/Session/MarburgumAccountSubsystem.cpp(255)
#: Source/MarburgumIIClient/Private/Session/MarburgumAccountSubsystem.cpp(255)
msgctxt "MarburgumAccount,CodeSent"
msgid "We sent a message to {0}. Type the eight-character code from it below."
msgstr "Na naslov {0} smo poslali sporočilo. Spodaj vpiši osemmestno kodo iz sporočila."

#. Key:	Confirmed
#. SourceLocation:	Source/MarburgumIIClient/Private/Session/MarburgumAccountSubsystem.cpp(286)
#: Source/MarburgumIIClient/Private/Session/MarburgumAccountSubsystem.cpp(286)
msgctxt "MarburgumAccount,Confirmed"
msgid "Email confirmed. Choose the username and password you will sign in with."
msgstr "E-poštni naslov je potrjen. Izberi uporabniško ime in geslo za prijavo."

#. Key:	ResetSent
#. SourceLocation:	Source/MarburgumIIClient/Private/Session/MarburgumAccountSubsystem.cpp(339)
#: Source/MarburgumIIClient/Private/Session/MarburgumAccountSubsystem.cpp(339)
msgctxt "MarburgumAccount,ResetSent"
msgid "If {0} has an account, a reset code is on its way, with your username."
msgstr "Če je naslov {0} povezan z računom, boš nanj prejel kodo za ponastavitev in svoje uporabniško ime."

#. Key:	ResetDone
#. SourceLocation:	Source/MarburgumIIClient/Private/Session/MarburgumAccountSubsystem.cpp(361)
#: Source/MarburgumIIClient/Private/Session/MarburgumAccountSubsystem.cpp(361)
msgctxt "MarburgumAccount,ResetDone"
msgid "Password changed. Every other session was signed out. Sign in with the new password."
msgstr "Geslo je spremenjeno. Vse druge seje so bile odjavljene. Prijavi se z novim geslom."

#. Key:	Created
#. SourceLocation:	Source/MarburgumIIClient/Private/Session/MarburgumAccountSubsystem.cpp(389)
#: Source/MarburgumIIClient/Private/Session/MarburgumAccountSubsystem.cpp(389)
msgctxt "MarburgumAccount,Created"
msgid "{0} {1} is ready. Enter the world when you are."
msgstr "Lik {0} {1} je pripravljen. Vstopi v svet, ko boš nared."

#. Key:	SignInFirst
#. SourceLocation:	Source/MarburgumIIClient/Private/Session/MarburgumAccountSubsystem.cpp(423)
#: Source/MarburgumIIClient/Private/Session/MarburgumAccountSubsystem.cpp(423)
msgctxt "MarburgumAccount,SignInFirst"
msgid "Sign in and create your character first."
msgstr "Najprej se prijavi in ustvari svoj lik."

#. Key:	EmailInvalid
#. SourceLocation:	Source/MarburgumIIClient/Private/Session/MarburgumAccountSubsystem.cpp(69)
#: Source/MarburgumIIClient/Private/Session/MarburgumAccountSubsystem.cpp(69)
msgctxt "MarburgumAccount,EmailInvalid"
msgid "That does not look like an email address."
msgstr "To ni videti kot e-poštni naslov."

#. Key:	ResendTooSoon
#. SourceLocation:	Source/MarburgumIIClient/Private/Session/MarburgumAccountSubsystem.cpp(70)
#: Source/MarburgumIIClient/Private/Session/MarburgumAccountSubsystem.cpp(70)
msgctxt "MarburgumAccount,ResendTooSoon"
msgid "A code was sent a moment ago. Wait a minute before asking for another."
msgstr "Koda je bila pravkar poslana. Počakaj minuto, preden zahtevaš novo."

#. Key:	CodeInvalid
#. SourceLocation:	Source/MarburgumIIClient/Private/Session/MarburgumAccountSubsystem.cpp(71)
#: Source/MarburgumIIClient/Private/Session/MarburgumAccountSubsystem.cpp(71)
msgctxt "MarburgumAccount,CodeInvalid"
msgid "That code is wrong, used or expired. Check the email, or ask for a new code."
msgstr "Koda je napačna, že uporabljena ali potekla. Preveri e-poštno sporočilo ali zahtevaj novo kodo."

#. Key:	SetupExpired
#. SourceLocation:	Source/MarburgumIIClient/Private/Session/MarburgumAccountSubsystem.cpp(72)
#: Source/MarburgumIIClient/Private/Session/MarburgumAccountSubsystem.cpp(72)
msgctxt "MarburgumAccount,SetupExpired"
msgid "This confirmation has expired. Start again with your email address."
msgstr "Ta potrditev je potekla. Začni znova z vnosom e-poštnega naslova."

#. Key:	UsernameLength
#. SourceLocation:	Source/MarburgumIIClient/Private/Session/MarburgumAccountSubsystem.cpp(73)
#: Source/MarburgumIIClient/Private/Session/MarburgumAccountSubsystem.cpp(73)
msgctxt "MarburgumAccount,UsernameLength"
msgid "A username is 3 to 20 characters."
msgstr "Uporabniško ime mora imeti od 3 do 20 znakov."

#. Key:	UsernameCharacters
#. SourceLocation:	Source/MarburgumIIClient/Private/Session/MarburgumAccountSubsystem.cpp(74)
#: Source/MarburgumIIClient/Private/Session/MarburgumAccountSubsystem.cpp(74)
msgctxt "MarburgumAccount,UsernameCharacters"
msgid "Use letters a–z, digits, dots, dashes or underscores, starting with a letter or digit."
msgstr "Uporabi črke a–z, števke, pike, vezaje ali podčrtaje. Začni s črko ali števko."

#. Key:	UsernameReserved
#. SourceLocation:	Source/MarburgumIIClient/Private/Session/MarburgumAccountSubsystem.cpp(75)
#: Source/MarburgumIIClient/Private/Session/MarburgumAccountSubsystem.cpp(75)
msgctxt "MarburgumAccount,UsernameReserved"
msgid "That username is reserved. Choose another."
msgstr "To uporabniško ime je rezervirano. Izberi drugo."

#. Key:	UsernameTaken
#. SourceLocation:	Source/MarburgumIIClient/Private/Session/MarburgumAccountSubsystem.cpp(76)
#: Source/MarburgumIIClient/Private/Session/MarburgumAccountSubsystem.cpp(76)
msgctxt "MarburgumAccount,UsernameTaken"
msgid "That username is taken. Choose another."
msgstr "To uporabniško ime je zasedeno. Izberi drugo."

#. Key:	PasswordLength
#. SourceLocation:	Source/MarburgumIIClient/Private/Session/MarburgumAccountSubsystem.cpp(77)
#: Source/MarburgumIIClient/Private/Session/MarburgumAccountSubsystem.cpp(77)
msgctxt "MarburgumAccount,PasswordLength"
msgid "A password is 10 to 128 characters."
msgstr "Geslo mora imeti od 10 do 128 znakov."

#. Key:	PasswordUsername
#. SourceLocation:	Source/MarburgumIIClient/Private/Session/MarburgumAccountSubsystem.cpp(78)
#: Source/MarburgumIIClient/Private/Session/MarburgumAccountSubsystem.cpp(78)
msgctxt "MarburgumAccount,PasswordUsername"
msgid "The password must not contain your username or be your email address."
msgstr "Geslo ne sme vsebovati tvojega uporabniškega imena ali biti enako tvojemu e-poštnemu naslovu."

#. Key:	CredentialsInvalid
#. SourceLocation:	Source/MarburgumIIClient/Private/Session/MarburgumAccountSubsystem.cpp(79)
#: Source/MarburgumIIClient/Private/Session/MarburgumAccountSubsystem.cpp(79)
msgctxt "MarburgumAccount,CredentialsInvalid"
msgid "That username and password do not match."
msgstr "Uporabniško ime in geslo se ne ujemata."

#. Key:	TooMany
#. SourceLocation:	Source/MarburgumIIClient/Private/Session/MarburgumAccountSubsystem.cpp(80)
#: Source/MarburgumIIClient/Private/Session/MarburgumAccountSubsystem.cpp(80)
msgctxt "MarburgumAccount,TooMany"
msgid "Too many wrong passwords. Wait fifteen minutes, or reset the password."
msgstr "Preveč napačnih vnosov gesla. Počakaj petnajst minut ali ponastavi geslo."

#. Key:	SessionInvalid
#. SourceLocation:	Source/MarburgumIIClient/Private/Session/MarburgumAccountSubsystem.cpp(81)
#: Source/MarburgumIIClient/Private/Session/MarburgumAccountSubsystem.cpp(81)
msgctxt "MarburgumAccount,SessionInvalid"
msgid "You have been signed out. Sign in again."
msgstr "Tvoja seja je bila odjavljena. Prijavi se znova."

#. Key:	FirstLength
#. SourceLocation:	Source/MarburgumIIClient/Private/Session/MarburgumAccountSubsystem.cpp(82)
#: Source/MarburgumIIClient/Private/Session/MarburgumAccountSubsystem.cpp(82)
msgctxt "MarburgumAccount,FirstLength"
msgid "A first name is 2 to 24 characters."
msgstr "Ime mora imeti od 2 do 24 znakov."

#. Key:	FirstCharacters
#. SourceLocation:	Source/MarburgumIIClient/Private/Session/MarburgumAccountSubsystem.cpp(83)
#: Source/MarburgumIIClient/Private/Session/MarburgumAccountSubsystem.cpp(83)
msgctxt "MarburgumAccount,FirstCharacters"
msgid "A first name uses letters, with single spaces, hyphens or apostrophes between them."
msgstr "Ime je sestavljeno iz črk, med katerimi so lahko posamezni presledki, vezaji ali opuščaji."

#. Key:	FirstReserved
#. SourceLocation:	Source/MarburgumIIClient/Private/Session/MarburgumAccountSubsystem.cpp(84)
#: Source/MarburgumIIClient/Private/Session/MarburgumAccountSubsystem.cpp(84)
msgctxt "MarburgumAccount,FirstReserved"
msgid "That first name is reserved. Choose another."
msgstr "To ime je rezervirano. Izberi drugo."

#. Key:	LastLength
#. SourceLocation:	Source/MarburgumIIClient/Private/Session/MarburgumAccountSubsystem.cpp(85)
#: Source/MarburgumIIClient/Private/Session/MarburgumAccountSubsystem.cpp(85)
msgctxt "MarburgumAccount,LastLength"
msgid "A last name is 2 to 24 characters."
msgstr "Priimek mora imeti od 2 do 24 znakov."

#. Key:	LastCharacters
#. SourceLocation:	Source/MarburgumIIClient/Private/Session/MarburgumAccountSubsystem.cpp(86)
#: Source/MarburgumIIClient/Private/Session/MarburgumAccountSubsystem.cpp(86)
msgctxt "MarburgumAccount,LastCharacters"
msgid "A last name uses letters, with single spaces, hyphens or apostrophes between them."
msgstr "Priimek je sestavljen iz črk, med katerimi so lahko posamezni presledki, vezaji ali opuščaji."

#. Key:	LastReserved
#. SourceLocation:	Source/MarburgumIIClient/Private/Session/MarburgumAccountSubsystem.cpp(87)
#: Source/MarburgumIIClient/Private/Session/MarburgumAccountSubsystem.cpp(87)
msgctxt "MarburgumAccount,LastReserved"
msgid "That last name is reserved. Choose another."
msgstr "Ta priimek je rezerviran. Izberi drugega."

#. Key:	ModelUnknown
#. SourceLocation:	Source/MarburgumIIClient/Private/Session/MarburgumAccountSubsystem.cpp(88)
#: Source/MarburgumIIClient/Private/Session/MarburgumAccountSubsystem.cpp(88)
msgctxt "MarburgumAccount,ModelUnknown"
msgid "Choose one of the bodies shown."
msgstr "Izberi eno od prikazanih teles."

#. Key:	CharacterExists
#. SourceLocation:	Source/MarburgumIIClient/Private/Session/MarburgumAccountSubsystem.cpp(89)
#: Source/MarburgumIIClient/Private/Session/MarburgumAccountSubsystem.cpp(89)
msgctxt "MarburgumAccount,CharacterExists"
msgid "This account already has its character."
msgstr "Ta račun že ima svoj lik."

#. Key:	NoCharacter
#. SourceLocation:	Source/MarburgumIIClient/Private/Session/MarburgumAccountSubsystem.cpp(90)
#: Source/MarburgumIIClient/Private/Session/MarburgumAccountSubsystem.cpp(90)
msgctxt "MarburgumAccount,NoCharacter"
msgid "Create your character first."
msgstr "Najprej ustvari svoj lik."

#. Key:	ServerUnknown
#. SourceLocation:	Source/MarburgumIIClient/Private/Session/MarburgumAccountSubsystem.cpp(91)
#: Source/MarburgumIIClient/Private/Session/MarburgumAccountSubsystem.cpp(91)
msgctxt "MarburgumAccount,ServerUnknown"
msgid "That address is not a Marburgum world. Check the server address."
msgstr "Ta naslov ni svet Marburguma. Preveri naslov strežnika."

#. Key:	StoreUnavailable
#. SourceLocation:	Source/MarburgumIIClient/Private/Session/MarburgumAccountSubsystem.cpp(92)
#: Source/MarburgumIIClient/Private/Session/MarburgumAccountSubsystem.cpp(92)
msgctxt "MarburgumAccount,StoreUnavailable"
msgid "The account service could not save. Nothing changed; try again."
msgstr "Storitev za račune ni mogla shraniti podatkov. Nič se ni spremenilo; poskusi znova."

#. Key:	MailUnavailable
#. SourceLocation:	Source/MarburgumIIClient/Private/Session/MarburgumAccountSubsystem.cpp(93)
#: Source/MarburgumIIClient/Private/Session/MarburgumAccountSubsystem.cpp(93)
msgctxt "MarburgumAccount,MailUnavailable"
msgid "The email could not be sent. Try again in a minute."
msgstr "E-poštnega sporočila ni bilo mogoče poslati. Poskusi znova čez minuto."

#. Key:	Unreachable
#. SourceLocation:	Source/MarburgumIIClient/Private/Session/MarburgumAccountSubsystem.cpp(94)
#: Source/MarburgumIIClient/Private/Session/MarburgumAccountSubsystem.cpp(94)
msgctxt "MarburgumAccount,Unreachable"
msgid "The account service cannot be reached. Check your connection and try again."
msgstr "Storitev za račune ni dosegljiva. Preveri povezavo in poskusi znova."

#. Key:	TooManyRequests
#. SourceLocation:	Source/MarburgumIIClient/Private/Session/MarburgumAccountSubsystem.cpp(96)
#: Source/MarburgumIIClient/Private/Session/MarburgumAccountSubsystem.cpp(96)
msgctxt "MarburgumAccount,TooManyRequests"
msgid "Too many requests from this connection. Wait a minute and try again."
msgstr "Preveč zahtev s te povezave. Počakaj minuto in poskusi znova."

#. Key:	ServiceBusy
#. SourceLocation:	Source/MarburgumIIClient/Private/Session/MarburgumAccountSubsystem.cpp(97)
#: Source/MarburgumIIClient/Private/Session/MarburgumAccountSubsystem.cpp(97)
msgctxt "MarburgumAccount,ServiceBusy"
msgid "The account service is busy. Try again in a moment."
msgstr "Storitev za račune je zasedena. Poskusi znova čez trenutek."

#. Key:	RequestInvalid
#. SourceLocation:	Source/MarburgumIIClient/Private/Session/MarburgumAccountSubsystem.cpp(98)
#: Source/MarburgumIIClient/Private/Session/MarburgumAccountSubsystem.cpp(98)
msgctxt "MarburgumAccount,RequestInvalid"
msgid "The account service did not understand the request. Update the game and try again."
msgstr "Storitev za račune ni razumela zahteve. Posodobi igro in poskusi znova."

#. Key:	NotFound
#. SourceLocation:	Source/MarburgumIIClient/Private/Session/MarburgumAccountSubsystem.cpp(99)
#: Source/MarburgumIIClient/Private/Session/MarburgumAccountSubsystem.cpp(99)
msgctxt "MarburgumAccount,NotFound"
msgid "The account service did not understand the request. Update the game and try again."
msgstr "Storitev za račune ni razumela zahteve. Posodobi igro in poskusi znova."

#. Key:	Footer
#. SourceLocation:	Source/MarburgumIIClient/Private/UI/MarburgumAccountScreen.cpp(119)
#: Source/MarburgumIIClient/Private/UI/MarburgumAccountScreen.cpp(119)
msgctxt "MarburgumAccountScreen,Footer"
msgid "Development preview  ·  account service: email codes are written to the service's outbox folder until a mail sender is chosen"
msgstr "Predogled razvojne različice  ·  storitev za račune: e-poštne kode se zapisujejo v mapo za odhodno pošto storitve, dokler ni izbran pošiljatelj e-pošte"

#. Key:	Series
#. SourceLocation:	Source/MarburgumIIClient/Private/UI/MarburgumAccountScreen.cpp(195)
#: Source/MarburgumIIClient/Private/UI/MarburgumAccountScreen.cpp(195)
msgctxt "MarburgumAccountScreen,Series"
msgid "MAGNA RAEDARUM"
msgstr "MAGNA RAEDARUM"

#. Key:	Title
#. SourceLocation:	Source/MarburgumIIClient/Private/UI/MarburgumAccountScreen.cpp(196)
#: Source/MarburgumIIClient/Private/UI/MarburgumAccountScreen.cpp(196)
msgctxt "MarburgumAccountScreen,Title"
msgid "MARBURGUM II"
msgstr "MARBURGUM II"

#. Key:	Tagline
#. SourceLocation:	Source/MarburgumIIClient/Private/UI/MarburgumAccountScreen.cpp(200)
#: Source/MarburgumIIClient/Private/UI/MarburgumAccountScreen.cpp(200)
msgctxt "MarburgumAccountScreen,Tagline"
msgid "A persistent urban role-playing game  ·  Maribor, the 1990s"
