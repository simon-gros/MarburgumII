# Unreal generated data
/Binaries/
/DerivedDataCache/
/Intermediate/
/Saved/
/Build/*/FileOpenOrder/
/Content/Developers/
/Content/Collections/
/.vs/
*.sln
*.suo
*.VC.db
*.xcodeproj
*.xcworkspace
# GenerateProjectFiles.sh output (Linux Makefile/CMake/VS Code)
/Makefile
/CMakeLists.txt
/*.code-workspace
/.ignore
# Developer tools
**/bin/
**/obj/
**/target/
.idea/
.vscode/
.DS_Store
Thumbs.db

# Locally purchased/licensed commercial map assets — NEVER commit raw, derived or extractable source.
/ThirdParty/Licensed/
/Content/Licensed/
/Content/ThirdPartyLicensed/
/PrivateAssets/
# Local generator inputs, outputs and checkpoints are not public game source.
/AssetGeneration/
/Models/LocalCheckpoints/
/LocalGenerators/
.env
.env.*
!.env.example

# Python bytecode from local script/test runs
__pycache__/

# NVIDIA's DLSS/Streamline Unreal plugins are installed locally under NVIDIA's licence (ADR-029); never commit them.
/Plugins/DLSS/
/Plugins/DLSSMoviePipelineSupport/
/Plugins/NIS/
/Plugins/Streamline*/
# DLSS5ForUE5 is committed as source only (ADR-030); its build output and the NVIDIA Neural Rendering runtime never are.
/Plugins/*/Binaries/
/Plugins/*/Intermediate/
nvngx_dlssnr.dll
