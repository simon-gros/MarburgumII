{
  "schema": 1,
  "engine_root": "/mnt/data/unreal/5.8.4",
  "asset_roots": [],
  "import_commands": [],
  "build_commands": [
    [
      "bash",
      "{repo}/scripts/build-linux.sh",
      "MarburgumIIServer"
    ],
    [
      "bash",
      "{repo}/scripts/build-linux.sh",
      "MarburgumIIClient"
    ]
  ],
  "cook_commands": [
    [
      "bash",
      "{engine_root}/Engine/Build/BatchFiles/RunUAT.sh",
      "BuildCookRun",
      "-ubtargs=-WaitMutex",
      "-project={project_file}",
      "-noP4",
      "-unattended",
      "-utf8output",
      "-platform=Linux",
      "-client",
      "-clientconfig=Development",
      "-build",
      "-cook",
      "-stage",
      "-pak",
      "-archive",
      "-archivedirectory={run_dir}",
      "-map=/Game/Maps/FrontEnd+/Game/Maps/NetSmoke+/Game/Maps/Lent+/Game/World/lent"
    ],
    [
      "bash",
      "{engine_root}/Engine/Build/BatchFiles/RunUAT.sh",
      "BuildCookRun",
      "-ubtargs=-WaitMutex",
      "-project={project_file}",
      "-noP4",
      "-unattended",
      "-utf8output",
      "-server",
      "-noclient",
      "-serverplatform=Linux",
      "-serverconfig=Development",
      "-build",
      "-cook",
      "-stage",
      "-pak",
      "-archive",
      "-archivedirectory={run_dir}",
      "-map=/Game/Maps/FrontEnd+/Game/Maps/NetSmoke+/Game/Maps/Lent+/Game/World/lent"
    ]
  ],
  "artifact_roots": {
    "client": "{run_dir}/LinuxClient",
    "server": "{run_dir}/LinuxServer"
  },
  "launch_commands": [
    {
      "role": "server",
      "command": [
        "{run_dir}/LinuxServer/MarburgumIIServer.sh",
        "/Game/World/lent",
        "-port=17777",
        "-MB2WorldStore={run_dir}/world-store.json",
        "-log",
        "-unattended",
        "-nosplash"
      ]
    },
    {
      "role": "client",
      "command": [
        "{run_dir}/LinuxClient/MarburgumIIClient.sh",
        "127.0.0.1:17777?MB2Start=arrival?MB2Character=playtest-a",
        "-windowed",
        "-ResX=1600",
        "-ResY=900",
        "-log",
        "-nosplash"
      ]
    },
    {
      "role": "client",
      "command": [
        "{run_dir}/LinuxClient/MarburgumIIClient.sh",
        "127.0.0.1:17777?MB2Start=bridge?MB2Character=playtest-b",
        "-RenderOffScreen",
        "-windowed",
        "-ForceRes",
        "-ResX=1280",
        "-ResY=720",
        "-nosound",
        "-unattended",
        "-log",
        "-nosplash"
      ]
    }
  ]
}
